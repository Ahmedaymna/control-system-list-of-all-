{
  "expo": {
    "name": "Control System List",
    "slug": "control-system-list",
    "extra": {
      "eas": {
        "projectId": "13a36d93-858d-441c-855a-fe5d6159795d"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "control-system-list",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050810"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.controlsystemlist"
    },
    "android": {
      "package": "com.controlsystemlist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#050810"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
